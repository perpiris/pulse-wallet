<Project>

  <!-- Settings shared by every project in the solution. MSBuild picks this file up automatically
       for any project in this folder or below, so new projects get them with no extra setup. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Fail the build on warnings, so they get fixed instead of piling up. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Run the latest .NET code analyzers and enforce .editorconfig code style during build,
         not just in the IDE. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- "Recommended" turns on many more code quality (CA) rules as build warnings than the small
         "Default" set: performance, reliability, globalization and design checks. Fine-tune single
         rules in .editorconfig with dotnet_diagnostic.<ID>.severity. -->
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Needed for the compiler to report unused usings (IDE0005) during build, not only in the IDE.
         CS1591 (missing XML comments on public members) is silenced: we don't want docs on everything. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
