<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: each one runs its own tests. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PulseWallet.Application\PulseWallet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft's coverage extension for Microsoft.Testing.Platform: lets dotnet test collect code coverage. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <!-- Flags NSubstitute mistakes at build time, like setting up a non-virtual member that can't be substituted. -->
    <PackageReference Include="NSubstitute.Analyzers.CSharp" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NSubstitute" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>